# ─── Instagram Platform (Instagram API with Instagram Login) ───────────────
# Create an app at https://developers.facebook.com, add the "Instagram" product,
# and connect an Instagram professional (Business/Creator) account.
IG_APP_ID=your_instagram_app_id
IG_APP_SECRET=your_instagram_app_secret
# Long-lived Instagram User access token for the connected professional account.
IG_ACCESS_TOKEN=your_long_lived_instagram_user_access_token
# Graph API version used for messaging calls (host: graph.instagram.com).
GRAPH_API_VERSION=v25.0
# Any random string; you enter the same value in the webhook config UI.
WEBHOOK_VERIFY_TOKEN=choose_a_random_verify_token

# ─── AI provider (any OpenAI-compatible /v1/chat/completions endpoint) ─────
# Examples:
#   OpenAI      -> https://api.openai.com/v1
#   Anthropic   -> https://api.anthropic.com/v1   (OpenAI-compatible endpoint)
#   OpenRouter  -> https://openrouter.ai/api/v1
#   Groq        -> https://api.groq.com/openai/v1
#   Local (vLLM/Ollama) -> http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_provider_api_key
AI_MODEL=gpt-4o-mini

# ─── Creator / business config ───────────────────────────────────────────
# Displayed name of the human this assistant works on behalf of.
CREATOR_DISPLAY_NAME=Your Name
# Short description of the business the assistant should represent (no sexual content).
CREATOR_BIO=I'm an independent creator. I post lifestyle and behind-the-scenes content.
# A single URL shared ONLY when a user explicitly asks where to subscribe / for a link.
# NOTE: routing links that solicit adult services through Instagram DMs may still
# violate the Instagram Platform Terms regardless of this software. See COMPLIANCE.md.
SUBSCRIPTION_URL=
# Set to "false" to never send any link automatically (assistant will tell users to
# check the profile bio instead).
ALLOW_LINK_ON_REQUEST=true

# ─── Runtime ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Optional: Redis for multi-instance state (opt-out list, dedupe, queues).
REDIS_URL=
POLLING_INTERVAL=5000
MAX_POLLING_DURATION=20000
# Data retention for conversation logs, in days.
LOG_RETENTION_DAYS=30
